# ==============================================================================
# StockBot Environment Variables Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🌟 主要 LLM 端點 (Primary LLM - 例如 OpenAI / Azure / 自訂端點)
# ------------------------------------------------------------------------------
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_API_KEY=sk-proj-your_openai_api_key_here
PRIMARY_TOOL_MODEL=gpt-4o-mini       # 專用於 Function Calling / 意圖識別工具調用
PRIMARY_MODEL=gpt-4o-mini            # 專用於伴隨說明文字與自然語言對話生成
# 財務指標直接回答與大師綜合判讀沿用 MODEL / FALLBACK_n_MODEL，無需額外金鑰。

# 傳統相容變數（若未設置 PRIMARY_*，則自動讀取下列變數）：
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
MODEL=gpt-4o-mini
TOOL_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. 🛡️ 第 1 備用端點 (Fallback #1 - 如 Groq 極速推理)
# ------------------------------------------------------------------------------
FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_1_API_KEY=gsk_your_groq_api_key_here
FALLBACK_1_TOOL_MODEL=openai/gpt-oss-20b
FALLBACK_1_MODEL=openai/gpt-oss-20b

# 或使用 Groq 專屬命名：
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_TOOL_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 3. 🛡️ 第 2 備用端點 (Fallback #2 - 如 Google Gemini OpenAI-Compatible)
# ------------------------------------------------------------------------------
FALLBACK_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_2_API_KEY=your_gemini_api_key_here
FALLBACK_2_TOOL_MODEL=gemini-2.5-flash
FALLBACK_2_MODEL=gemini-2.5-flash

# 或使用 Google Gemini 專屬命名：
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. 🛡️ 第 3 備用端點 (Fallback #3 - 如 DeepSeek / Azure OpenAI)
# ------------------------------------------------------------------------------
FALLBACK_3_BASE_URL=https://api.deepseek.com/v1
FALLBACK_3_API_KEY=sk-your_deepseek_api_key_here
FALLBACK_3_TOOL_MODEL=deepseek-chat
FALLBACK_3_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 5. 🌐 2MD 即時連網與財經搜尋端點 (Real-Time Web & Financial SERP Search)
# ------------------------------------------------------------------------------
TWOMD_PRIMARY_URL=https://2md.aiurl.tw
TWOMD_BACKUP1_URL=https://2md.glsoft.ai
TWOMD_BACKUP2_URL=https://create360.ai
ANSWERBOOK_BASE_URL=https://answerbook.david888.com

# ------------------------------------------------------------------------------
# 6. 🏛️ AI Hedge Fund API (14 位傳奇投資大師與圓桌辯論後端)
# ------------------------------------------------------------------------------
AI_HEDGE_FUND_HOST=dns.glsoft.ai
AI_HEDGE_FUND_PORT=6000

# 量化分析使用公開 Yahoo Finance 結構化資料，不需要新增 API 金鑰。
# 若上游沒有提供某項數據，Stockbot 會顯示「待確認」而不填入假值。
