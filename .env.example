# ==============================================================================
# StockBot Environment Variables Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🌟 主要 LLM 端點 (Primary LLM / Tier 0)
# ------------------------------------------------------------------------------
PRIMARY_BASE_URL=https://nen.com.tw/v1
PRIMARY_API_KEY=your_primary_api_key_here
PRIMARY_TOOL_MODEL=gpt-5.6-luna      # 專用於 Function Calling / 意圖識別工具調用
PRIMARY_MODEL=gpt-5.6-luna           # 專用於伴隨說明文字與自然語言對話生成

# 傳統相容變數（若未設置 PRIMARY_*，則自動讀取下列變數）：
OPENAI_BASE_URL=https://nen.com.tw/v1
OPENAI_API_KEY=your_primary_api_key_here
MODEL=gpt-5.6-luna
TOOL_MODEL=gpt-5.6-luna

# ------------------------------------------------------------------------------
# 2. 🛡️ 第 1 備用端點 (Fallback #1 - 如 Groq 高速推理)
# ------------------------------------------------------------------------------
FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_1_API_KEY=gsk_your_groq_api_key_here
FALLBACK_1_TOOL_MODEL=openai/gpt-oss-20b
FALLBACK_1_MODEL=openai/gpt-oss-20b

# 或使用 Groq 專屬命名：
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_TOOL_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 3. 🛡️ 第 2 備用端點 (Fallback #2 - 如 官方 OpenAI / 其他 OpenAI-Compatible)
# ------------------------------------------------------------------------------
FALLBACK_2_BASE_URL=https://api.openai.com/v1
FALLBACK_2_API_KEY=sk-proj-your_openai_api_key_here
FALLBACK_2_TOOL_MODEL=gpt-4o-mini
FALLBACK_2_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. 🛡️ 第 3 備用端點 (Fallback #3 - 如 DeepSeek 官方端點)
# ------------------------------------------------------------------------------
FALLBACK_3_BASE_URL=https://api.deepseek.com/v1
FALLBACK_3_API_KEY=sk-your_deepseek_api_key_here
FALLBACK_3_TOOL_MODEL=deepseek-chat
FALLBACK_3_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 5. 🌐 2MD 即時連網與財經搜尋端點 (Real-Time Web & Financial SERP Search)
# ------------------------------------------------------------------------------
TWOMD_PRIMARY_URL=https://2md.aiurl.tw
TWOMD_BACKUP1_URL=https://2md.glsoft.ai
TWOMD_BACKUP2_URL=https://create360.ai

# ------------------------------------------------------------------------------
# 6. 🏛️ AI Hedge Fund API (14 位傳奇投資大師與圓桌辯論後端)
# ------------------------------------------------------------------------------
AI_HEDGE_FUND_HOST=dns.glsoft.ai
AI_HEDGE_FUND_PORT=6000
